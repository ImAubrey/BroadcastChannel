---
import Layout from '../layouts/base.astro'
import Header from '../components/header.astro'
import Item from '../components/item.astro'

const { SITE_URL } = Astro.locals
const { channel, before = true, after = true } = Astro.props
const posts = channel.posts ?? []

const beforeCursor = posts[posts.length - 1]?.id
const afterCursor = posts[0]?.id
const noticeTags = new Set(['通知', '公告', 'notice', 'announcement'])
const noticeIndex = posts.findIndex((post) =>
  (post?.tags ?? []).some((tag) =>
    noticeTags.has(String(tag || '').toLowerCase()),
  ),
)
const noticePost = noticeIndex >= 0 ? posts[noticeIndex] : null
const feedPosts =
  noticeIndex >= 0 ? posts.filter((_, index) => index !== noticeIndex) : posts
const tagCounts = posts.reduce((acc, post) => {
  const tags = post?.tags ?? []
  tags.forEach((tag) => {
    const cleanTag = String(tag || '').trim()
    if (!cleanTag) return
    acc.set(cleanTag, (acc.get(cleanTag) ?? 0) + 1)
  })
  return acc
}, new Map())
const tagList = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 24)

const tagHue = (tag) => {
  let hash = 0
  for (let i = 0; i < tag.length; i += 1) {
    hash = (hash * 31 + tag.charCodeAt(i)) % 360
  }
  return hash
}
// const cursor = +Astro.params.cursor
---

<Layout channel={channel} id="main-container">
  <slot name="header">
    <Header channel={channel} />
  </slot>
  <div class="feed-tools">
    <form class="search-box" action="/search" method="get" role="search">
      <input
        type="text"
        name="q"
        placeholder="搜索频道内容 / Search"
        autocomplete="off"
      />
      <button type="submit">搜索</button>
    </form>
    {
      tagList.length > 0 && (
        <section class="tag-summary" aria-label="标签归类">
          <div class="tag-summary-title">标签归类</div>
          <div class="tag-summary-list">
            {tagList.map(([tag, count], index) => (
              <a
                href={`/search/%23${tag}`}
                title={tag}
                class="tag-chip"
                data-tag={tag}
                style={`--tag-hue:${tagHue(tag)}; --tag-index:${index};`}
              >
                <span class="tag-chip-label">#{tag}</span>
                <span class="tag-chip-count">{count}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
  {
    noticePost && (
      <section class="notice-section" aria-label="最新通知">
        <div class="notice-title">最新通知</div>
        <Item post={noticePost} index={0} variant="notice" />
      </section>
    )
  }
  <div class="items">
    {feedPosts.map((post, index) => <Item post={post} index={index} />)}
  </div>

  <div class="pages-container">
    {
      before && beforeCursor > 20 ? (
        <a
          href={`${SITE_URL}before/${beforeCursor}`}
          title="Before"
          class="page"
        >
          Before
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }

    <div class="pages-info"></div>
    {
      after && afterCursor ? (
        <a href={`${SITE_URL}after/${afterCursor}`} title="After" class="page">
          After
        </a>
      ) : (
        <span class="page-placeholder">&nbsp;</span>
      )
    }
  </div>
</Layout>
